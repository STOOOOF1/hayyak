# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server/script only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key

# Demo bootstrap identities. Supply strong local values in .env.local.
DEMO_PLATFORM_ADMIN_EMAIL=platform-admin@example.invalid
DEMO_PLATFORM_ADMIN_PASSWORD=replace_with_a_strong_local_password
DEMO_COFFEE_ADMIN_EMAIL=coffee-admin@example.invalid
DEMO_COFFEE_ADMIN_PASSWORD=replace_with_a_strong_local_password
DEMO_STAFF_EMAIL=staff@example.invalid
DEMO_STAFF_PASSWORD=replace_with_a_strong_local_password

